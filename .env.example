# SelfStats Environment Configuration

# Personal Access Token (PAT) for GitHub API requests
GITHUB_TOKEN=github_pat_your_github_personal_access_token_here

# Restrict allowed usernames (comma-separated list).
# Leave empty or set to * to allow any username.
# Example: ALLOWED_USERNAMES=octocat,github
ALLOWED_USERNAMES=

# Server Port
PORT=8080
